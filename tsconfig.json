{
  "compilerOptions": {
    /* Language and Environment */
    "target": "esnext",
    // UI 已从 CAT_UI 换成 React 19 + Ant Design v6（2026-10-06），组件用 .tsx 写
    "jsx": "react-jsx",

    /* Modules */
    // v26.10.06-v9：由 commonjs 改为 ESM 输出 —— UI 引入 antd 后，commonjs 会让 TS 产出
    // `require('antd')`（拉整个 barrel，实测 1.62MiB），webpack 无法 tree-shaking；
    // 改 ESM 后 webpack 才能只打包用到的组件。
    // v26.10.06-v18：moduleResolution 由 node(node10) 改为 **bundler** ——
    //   ① node10 已被 TS 6/7 标记弃用（编辑器里报「选项 moduleResolution=node10 已弃用，
    //      将在 TypeScript 7.0 停止运行」），bundler 是 webpack/Vite 这类打包器场景的正式选项；
    //   ② 它按 package.json 的 `exports` 解析子路径，antd 及其 @rc-component 依赖大量使用子路径导出，
    //      解析正确后 node_modules 里那批 .d.ts 报错也随之消失。
    //   ⚠️ bundler 需要 TS ≥5.0：本仓库 TypeScript 已随之升到 6.x（见 .vscode 的 typescript.tsdk 绑定）。
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolvePackageJsonImports": true,
    "paths": {
      "@/*": ["./src/*"],
      "#ui/*": ["./shared/ui/*"]
    },
    "types": ["tampermonkey"],
    "allowUmdGlobalAccess": true,

    /* JavaScript Support */
    "allowJs": true,
    "checkJs": false,

    /* Interop Constraints */
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    /* Type Checking */
    // 模板默认 strict: true。模块化完成后（2026-10-06）已整体开启；
    // 新增代码一律按 strict 写；确需临时放宽时请在具体行用 // @ts-expect-error 并注明原因，
    // 不要整体关掉 strict（见 AGENT.md「技术债务」）。
    "strict": true,
    // 唯一有意保留为 false 的 strict 子开关：本仓库沿用「catch (e) 后直接读 e.message 记日志」的既有写法
    // （storage/relay/gallery/monitor/clipboard/tinymce/qrcode/MainPanel 共 18 处），
    // 逐个改写成 instanceof 判断会改动 AST 且无实际收益。ES 的 e 仍可能是任意值，此处维持 4.4 之前的行为。
    "useUnknownInCatchVariables": false,

    /* Completeness */
    // v26.10.06-v9：UI 引入 antd 后打开 skipLibCheck —— antd 及其 @rc-component 的 .d.ts
    // 曾在本仓库配置下报出十余条不兼容错误（全部位于 node_modules）。
    // v26.10.06-v18：moduleResolution 改为 bundler 后这些解析问题已消失，但**暂时仍保留 true**：
    // 打开它只跳过第三方 .d.ts 的检查，本仓库自有代码依旧按 strict 全量检查（`npm run typecheck`）。
    "skipLibCheck": true
  },
  // shared/：脚本端与手机上传页共用（v26.10.08-v13）。
  // ⚠️ 不加进 include 的话，共享层会变成「能构建、但 npm run typecheck 不检查」的盲区。
  "include": ["src", "shared"]
}
