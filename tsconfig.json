{
  "compilerOptions": {
    /* Language and Environment */
    "target": "esnext",
    // v26.10.18-v7：UI 层已全部迁到 Vue（src-vue/**），业务层无 .tsx，不再需要 jsx 配置
    // （Vue SFC 的模板由 vue-tsc / @vitejs/plugin-vue 处理，见 tsconfig.vue.json）。

    /* Modules */
    // v26.10.14-v3：开 resolveJsonModule —— 表情包合集清单单一来源是
    // relay-server/emoji-sources.json（中继预热与脚本端 CDN 兜底共用，改合集只改一处）。
    "resolveJsonModule": true,
    // moduleResolution 由 node(node10) 改为 **bundler**（v26.10.06-v18）——
    //   ① node10 已被 TS 6/7 标记弃用（编辑器里报「选项 moduleResolution=node10 已弃用，
    //      将在 TypeScript 7.0 停止运行」），bundler 是 webpack/Vite 这类打包器场景的正式选项；
    //   ② 它按 package.json 的 `exports` 解析子路径，第三方包大量使用子路径导出，
    //      解析正确后 node_modules 里那批 .d.ts 报错也随之消失。
    //   ⚠️ bundler 需要 TS ≥5.0：本仓库 TypeScript 已随之升到 6.x（见 .vscode 的 typescript.tsdk 绑定）。
    "module": "esnext",
    "moduleResolution": "bundler",
    "paths": {
      "@/*": ["./src/*"],
      // Vue UI 迁移（2026-10-18）：shadcn-vue CLI 解析 components.json 的 aliases 时只读根 tsconfig；
      // v26.10.18-v7 起 src/lib/ui/notify.ts 也经它动态引入 @vue/lib/toast（Sonner 桥）。
      "@vue/*": ["./src-vue/*"]
    },
    "types": ["tampermonkey"],
    "allowUmdGlobalAccess": true,

    /* JavaScript Support */
    "allowJs": true,
    "checkJs": false,

    /* Interop Constraints */
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    /* Type Checking */
    // 模板默认 strict: true。模块化完成后（2026-10-06）已整体开启；
    // 新增代码一律按 strict 写；确需临时放宽时请在具体行用 // @ts-expect-error 并注明原因，
    // 不要整体关掉 strict（见 AGENT.md「技术债务」）。
    "strict": true,
    // 唯一有意保留为 false 的 strict 子开关：本仓库沿用「catch (e) 后直接读 e.message 记日志」的既有写法
    // （storage/relay/gallery/monitor/clipboard/tinymce/qrcode 等共 18 处），
    // 逐个改写成 instanceof 判断会改动 AST 且无实际收益。ES 的 e 仍可能是任意值，此处维持 4.4 之前的行为。
    "useUnknownInCatchVariables": false,

    /* Completeness */
    // v26.10.06-v9：UI 引入 antd 后打开 skipLibCheck —— antd 及其 @rc-component 的 .d.ts
    // 曾在本仓库配置下报出十余条不兼容错误（全部位于 node_modules）。
    // v26.10.06-v18：moduleResolution 改为 bundler 后这些解析问题已消失，但**暂时仍保留 true**：
    // 打开它只跳过第三方 .d.ts 的检查，本仓库自有代码依旧按 strict 全量检查（`npm run typecheck`）。
    // （antd 已随 Vue 迁移删除，此项保留是因为 reka-ui / vue-sonner 等第三方 .d.ts 同样不查。）
    "skipLibCheck": true
  },
  // shared/：脚本端与手机上传页共用（v26.10.08-v13）。
  // ⚠️ 不加进 include 的话，共享层会变成「能构建、但 npm run typecheck 不检查」的盲区。
  "include": ["src", "shared"]
}
