  "grant": [
    "GM_addStyle",
    "unsafeWindow",
    "GM_xmlhttpRequest",
    "GM_setClipboard",
    "GM_getValue",
    "GM_setValue",
    "GM_getResourceText",
    "GM_addValueChangeListener"
