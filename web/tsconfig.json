{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["vite/client"],
    // 复用的 UI 底层件在仓库根 src-vue/（与脚本端同一份），别名与 vite.config.ts 保持一致
    "paths": {
      "@vue/*": ["../src-vue/*"]
    }
  },
  // ../shared：与脚本端共用的纯逻辑层（v26.10.08-v13）。未设 rootDir、noEmit，故可 include 项目外文件。
  "include": ["src", "vite.config.ts", "../shared"]
}
