{
  "name": "znhd-service",
  "version": "26.10.09-v3",
  "description": "征纳互动人数和在线监控：油猴脚本（人数/掉线监控、语音播报、常用语、设备互联图片互传）",
  "main": "./dist/znhd.user.js",
  "scripts": {
    "start": "webpack serve --config ./config/webpack.dev.js --env filename=znhd.dev.user.js",
    "dev": "webpack --watch --config ./config/webpack.dev.js --env filename=znhd.dev.user.js",
    "build": "npm run lint:fix && webpack --config ./config/webpack.prod.js --env filename=znhd.user.js && node scripts/smoke/build-stamp.js write",
    "build:web": "npm --prefix web run build",
    "dev:web": "npm --prefix web run dev",
    "typecheck:web": "npm --prefix web run typecheck",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "npm run lint -- --fix",
    "typecheck": "tsc --noEmit",
    "check": "node --check dist/znhd.user.js && node --check relay-server/server.js && node --check relay-server/upload-page.js",
    "verify": "npm run verify:smoke && npm run verify:relay && npm run verify:web",
    "verify:smoke": "node scripts/smoke/run.js",
    "verify:relay": "node scripts/smoke/relay.js",
    "verify:web": "node scripts/smoke/phone-page.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Run-os/znhd-service.git"
  },
  "keywords": [
    "znhd",
    "TamperMonkey",
    "ScriptCat",
    "typescript"
  ],
  "author": "runos",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Run-os/znhd-service/issues"
  },
  "homepage": "https://scriptcat.org/zh-CN/script-show-page/3650",
  "devDependencies": {
    "@babel/core": "^7.17.9",
    "@babel/preset-env": "^7.16.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/tampermonkey": "^5.0.5",
    "@typescript-eslint/eslint-plugin": "^5.19.0",
    "@typescript-eslint/parser": "^5.19.0",
    "babel-loader": "^8.2.4",
    "css-loader": "^6.7.3",
    "eslint": "^8.13.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-html": "^6.2.0",
    "eslint-plugin-prettier": "^4.0.0",
    "html-webpack-plugin": "^5.5.0",
    "less": "^4.1.2",
    "less-loader": "^10.2.0",
    "postcss": "^8.5.29",
    "postcss-loader": "^8.2.1",
    "prettier": "^2.6.2",
    "puppeteer": "^25.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-to-print": "^3.3.0",
    "style-loader": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "terser-webpack-plugin": "^5.3.1",
    "to-string-loader": "^1.2.0",
    "ts-loader": "^9.2.8",
    "typescript": "^6.0.3",
    "webpack": "^5.72.0",
    "webpack-cli": "^4.9.2",
    "webpack-dev-server": "^4.9.0"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.12",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-progress": "^1.1.17",
    "@radix-ui/react-switch": "^1.3.8",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-tooltip": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.53.0",
    "radix-ui": "^1.7.0",
    "shadcn": "^4.21.4",
    "tw-animate-css": "^1.4.0"
  },
  "imports": {
    "#ui/*": "./shared/ui/*"
  }
}
