{
    "name": "znhd-service",
    "version": "26.10.21-v6",
    "description": "征纳互动人数和在线监控：油猴脚本（人数/掉线监控、语音播报、常用语、设备互联图片互传）",
    "main": "./dist/znhd.user.js",
    "scripts": {
        "dev": "vite",
        "start": "vite",
        "build": "npm run lint:fix && vite build",
        "build:vue": "npm run build",
        "dev:vue": "vite",
        "typecheck:vue": "vue-tsc -p tsconfig.vue.json --noEmit",
        "build:web": "npm --prefix web run build",
        "dev:web": "npm --prefix web run dev",
        "typecheck:web": "npm --prefix web run typecheck",
        "lint": "eslint \"src/**/*.ts\"",
        "lint:fix": "npm run lint -- --fix",
        "typecheck": "tsc --noEmit",
        "check": "node --check dist/znhd.user.js && node --check relay-server/server.js && node --check relay-server/upload-page.js",
        "verify": "npm run verify:vue && npm run verify:relay && npm run verify:web",
        "verify:vue": "node scripts/smoke/vue-panel.js",
        "verify:relay": "node scripts/smoke/relay.js",
        "verify:web": "node scripts/smoke/phone-page.js"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Run-os/znhd-service.git"
    },
    "keywords": [
        "znhd",
        "TamperMonkey",
        "ScriptCat",
        "typescript"
    ],
    "author": "runos",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/Run-os/znhd-service/issues"
    },
    "homepage": "https://scriptcat.org/zh-CN/script-show-page/3650",
    "devDependencies": {
        "@lucide/vue": "^1.59.0",
        "@tailwindcss/vite": "^4.3.3",
        "@types/tampermonkey": "^5.0.5",
        "@typescript-eslint/eslint-plugin": "^5.19.0",
        "@typescript-eslint/parser": "^5.19.0",
        "@vitejs/plugin-vue": "^6.0.10",
        "daisyui": "^5.7.50",
        "eslint": "^8.13.0",
        "eslint-config-prettier": "^8.5.0",
        "eslint-plugin-html": "^6.2.0",
        "eslint-plugin-prettier": "^4.0.0",
        "prettier": "^2.6.2",
        "puppeteer": "^25.12.0",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "vite": "^7.3.7",
        "vite-plugin-monkey": "^7.1.9",
        "vue": "^3.5.13",
        "vue-tsc": "^3.3.13"
    },
    "dependencies": {
        "@vueuse/core": "^15.0.0"
    }
}
